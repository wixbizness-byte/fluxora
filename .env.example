# Supabase Dashboard > Project Settings / Connect
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Server-only HMAC secret shared only with the homepage authorize/verify routes.
# Generate a strong random value. Never prefix this variable with NEXT_PUBLIC_.
HOMEPAGE_MEDIA_SECRET=YOUR_RANDOM_SERVER_ONLY_SECRET


# Fluxora Start onboarding analyzer (server only)
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_MODEL=deepseek-flash

# Server-only HMAC key used to anonymize Start onboarding rate-limit identities.
# Generate a separate strong random value. Never prefix with NEXT_PUBLIC_.
START_RATE_LIMIT_SECRET=YOUR_RANDOM_SERVER_ONLY_SECRET
